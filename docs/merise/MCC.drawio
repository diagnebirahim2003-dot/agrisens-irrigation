        <mxCell id="title" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" value="MCC — Système de gestion d'irrigation AgriSens" vertex="1"><mxGeometry x="380" y="0" width="740" height="30" as="geometry"/></mxCell>

